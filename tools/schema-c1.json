{
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_issues", "deviations_from_handoff", "title", "question_on_image", "facts_on_image", "x_caption",
               "scene_concept", "art_direction", "generation", "clue_mapping", "composition_plan", "difficulty_view", "risks"],
  "properties": {
    "handoff_issues": {"type": "array", "items": {"type": "string"}},
    "deviations_from_handoff": {"type": "array", "items": {"type": "string"}},
    "title": {"type": "string"},
    "question_on_image": {"type": "string"},
    "facts_on_image": {"type": "array", "items": {"type": "string"}},
    "x_caption": {"type": "string"},
    "scene_concept": {"type": "string"},
    "art_direction": {"type": "string"},
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "size", "must_appear", "must_not_appear"],
      "properties": {
        "prompt": {"type": "string"},
        "size": {"type": "string"},
        "must_appear": {"type": "array", "items": {"type": "string"}},
        "must_not_appear": {"type": "array", "items": {"type": "string"}}
      }
    },
    "clue_mapping": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["clue_id", "method", "depiction"],
                "properties": {"clue_id": {"type": "string"},
                               "method": {"type": "string", "enum": ["generated", "deterministic", "text", "hybrid"]},
                               "depiction": {"type": "string"}}}
    },
    "composition_plan": {"type": "string"},
    "difficulty_view": {"type": "string"},
    "risks": {"type": "array", "items": {"type": "string"}}
  }
}
